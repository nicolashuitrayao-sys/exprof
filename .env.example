# Copia a .env (junto a bin/, o en ~/.exprof.env) y completa. No subir .env a git.
EXPROF_SERVER=mi-servidor.ejemplo.local,1433
EXPROF_USER=mi_login
EXPROF_PASSWORD=CAMBIAR
EXPROF_DATABASE=master

# Opcionales (valores por defecto de la interfaz y del modo texto)
# EXPROF_FILTER=usp_Pago,usp_Contrato   # SPs a escuchar si no se pasan por argumento
# EXPROF_REDACT=1                       # ocultar valores de parametros por defecto (recomendado con datos reales)
# EXPROF_ENCRYPT=1                      # validar el certificado TLS del servidor
